{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Claude Session Exporter",
  "version": "0.1.2",
  "identifier": "com.claudesessionexporter.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Claude Session Exporter",
        "width": 1080,
        "height": 760,
        "minWidth": 760,
        "minHeight": 620
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "app", "nsis", "msi"],
    "category": "Productivity",
    "shortDescription": "Export Claude Desktop sessions to Markdown, JSON, and PDF.",
    "longDescription": "Claude Session Exporter reads Claude Desktop's own local files to save Home, Cowork, and Claude Code conversations as Markdown, JSON, and paginated PDFs. It runs entirely on your machine and contacts no server.",
    "copyright": "Claude Session Exporter Contributors",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
